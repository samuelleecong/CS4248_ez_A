{
  "model_name": "microsoft/codebert-base",
  "dataset_name": "google-research-datasets/mbpp",
  "batch_size": 8,
  "eval_batch_size": 8,
  "epochs": 1,
  "lr": 2e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "negatives_per_query": 2,
  "negative_strategy": "random",
  "negative_miner_model": "sentence-transformers/all-mpnet-base-v2",
  "hard_negative_pool_size": 20,
  "train_objective": "group_softmax",
  "pair_bce_weight": 0.25,
  "max_length": 512,
  "miner_batch_size": 64,
  "miner_max_query_length": 160,
  "miner_max_code_length": 256,
  "baseline_bi_encoder_model": "sentence-transformers/all-mpnet-base-v2",
  "seed": 42,
  "output_dir": "teachers/cross_encoder_tiny_smoke",
  "taco_val_size": 1000,
  "optimize_for_mps": false,
  "max_train_queries": 96,
  "max_eval_queries": 80,
  "save_model": true,
  "compare_to_baseline": false,
  "resolved_output_dir": "artifacts/teachers/cross_encoder_tiny_smoke"
}