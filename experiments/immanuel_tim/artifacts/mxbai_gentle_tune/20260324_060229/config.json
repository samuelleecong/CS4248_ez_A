  "miner_batch_size": 64,
  "miner_max_query_length": 160,
  "miner_max_code_length": 256,
  "baseline_bi_encoder_model": "sentence-transformers/all-mpnet-base-v2",
  "seed": 42,
  "output_dir": "teachers/mxbai_gentle_tune",
  "taco_val_size": 1000,
  "optimize_for_mps": false,
  "max_train_queries": 192,
